# The main job for {{.job_name}}.
resources:
  schemas:
    {{- if .landingzone_to_raw}}
    raw_{{.job_name}}:
      name: raw__{{.job_name}}
      catalog_name: ${var.catalog}
      comment: "The schema that contains raw {{.job_name}} tables.\nCreated by DABs."
      storage_root: ${var.storage_root}
    {{- end}}
    {{- if .raw_to_trusted}}
    trusted_{{.job_name}}:
      name: trusted__{{.job_name}}
      catalog_name: ${var.catalog}
      comment: "The schema that contains raw {{.job_name}} tables.\nCreated by DABs."
      storage_root: ${var.storage_root}
    {{- end}}
  volumes:
    {{- if .landingzone_to_raw}}
    raw_checkpoint_{{.job_name}}:
      name: checkpoint
      catalog_name: ${var.catalog}
      schema_name: ${resources.schemas.raw_{{.job_name}}.name}
      comment: "A managed volume to store streaming checkpoint data.\nCreated by DABs.\nDo not edit!"
    {{- end}}
    {{- if .raw_to_trusted}}
    trusted_checkpoint_{{.job_name}}:
      name: checkpoint
      catalog_name: ${var.catalog}
      schema_name: ${resources.schemas.trusted_{{.job_name}}.name}
      comment: "A managed volume to store streaming checkpoint data.\nCreated by DABs.\nDo not edit!"
    {{- end}}

  jobs:
    {{.job_name}}_job:
      name: {{.job_name}}_job

      schedule:
        quartz_cron_expression: "0 30 7 * * ?"  # Runs every day at 07:30 UTC
        timezone_id: UTC

      timeout_seconds: 3600  # Stop the job after 1 hour
      max_concurrent_runs: 1

      email_notifications:
        on_failure:
          - ${var.slack_channel_email}
      {{- if .use_serverless}}
        environments:
         - environment_key: "default_python"
           spec:
            environment_version: "4"
      {{- else}}
      job_clusters:
        - job_cluster_key: cluster
          new_cluster:
            node_type_id: {{smallest_node_type}}
            num_workers: 2
            spark_version: 17.3.x-scala2.13
            # Most workloads can use the default data security mode
            data_security_mode: USER_ISOLATION  # Supports Python, Scala and SQL

            # ML workloads or when you need to use a AWS service that requires an instance profile,
            # use the dedicated data security mode
            # data_security_mode: DATA_SECURITY_MODE_DEDICATED  # Supports all languages + ML
            # single_user_name: {{default_catalog}}
            # aws_attributes:
            #   instance_profile_arn: "TODO"

            custom_tags:
              CostCenter: COST_CENTER  # TODO: Replace COST_CENTER with the actual CostCenter
              Service: databricks
              EnvironmentType: ${var.env}
      {{- end}}

      tasks:
        {{- if .landingzone_to_raw}}
        - task_key: landingzone_to_raw
          {{- if .use_serverless}}
          environment_key: "default_python"
          {{- else}}
          job_cluster_key: cluster
          {{- end}}
          max_retries: 2
          notebook_task:
            notebook_path: ./landingzone_to_raw.py
            base_parameters:
              input_path: ${var.storage_root}/raw/PATH/TO/JSON/  # TODO: change this to the actual path where the raw JSON files are stored
              raw_table_name: ${resources.schemas.raw_{{.job_name}}.id}.table_name  # TODO: Replace the table_name
              checkpoint_path: ${resources.volumes.raw_checkpoint_{{.job_name}}.volume_path}
        {{- end}}
        {{- if .raw_to_trusted}}
        - task_key: raw_to_trusted
          {{- if .landingzone_to_raw}}
          depends_on:
            - task_key: landingzone_to_raw
          {{- end}}
          {{- if .use_serverless}}
          environment_key: "default_python"
          {{- else}}
          job_cluster_key: cluster
          {{- end}}
          max_retries: 2
          notebook_task:
            notebook_path: ./raw_to_trusted.py
            base_parameters:
              {{- if .landingzone_to_raw}}
              raw_table_name: ${resources.schemas.raw_{{.job_name}}.id}.table_name  # TODO: Replace the table_name
              {{- else}}
              raw_table_name: table_name  # TODO: Replace the table_name
              {{- end}}
              trusted_table_name: ${resources.schemas.trusted_{{.job_name}}.id}.table_name  # TODO: Replace the table_name
              checkpoint_path: ${resources.volumes.trusted_checkpoint_{{.job_name}}.volume_path}
        {{- end}}
